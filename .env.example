# Copy this file to .env (don't commit .env to GitHub) and fill in the
# real values.

# Login username for the site.
WEBSERVER_USERNAME=fabrice

# Password hash -- NEVER put the plaintext password here.
# Generate it with: python3 generate_password.py
WEBSERVER_PASSWORD_HASH=

# Optional second, read-only account: can open /control and watch the
# status bar/telemetry, but the Controls buttons and console command input
# are hidden, and /api/send refuses every command except the harmless
# read-only STA query -- useful for sharing a live view of the robot (e.g.
# over the internet) without letting that person actually drive it. Leave
# both empty to disable this account entirely (default).
WEBSERVER_VIEWER_USERNAME=
WEBSERVER_VIEWER_PASSWORD_HASH=

# Key used to sign the session cookie. Generate one with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# If missing, a random key is generated at server startup, but it then
# changes on every restart (everyone gets logged out).
FLASK_SECRET_KEY=

# Where the robot's control server (Pi #1, link/server.py in the robot
# repo) and its live camera stream listen. Pi #1 can be reached at more
# than one address depending on which network it's currently joined to
# (its Bbox/home fixed IP, or a temporary mobile-hotspot IP while testing
# in the zone d'essais) -- list every address it might have, comma-
# separated, in ROBOT_HOST_CANDIDATES, and this server tries them in turn
# (remembering whichever one last worked) instead of needing a manual
# edit + restart every time the robot changes network. Example for a
# robot that alternates between home and a Pixel hotspot:
#   ROBOT_HOST_CANDIDATES=192.168.1.180,10.88.252.73
# ROBOT_HOST below is still read as a single-address fallback if
# ROBOT_HOST_CANDIDATES is left unset (pre-2026-10-17 behavior).
ROBOT_HOST=192.168.1.180
#ROBOT_HOST_CANDIDATES=192.168.1.180,10.88.252.73
ROBOT_PORT=5050

# Where the robot's live camera stream (Pi #1, camera/stream_server.py in
# the robot repo) listens -- same host(s) as ROBOT_HOST/ROBOT_HOST_CANDIDATES
# above, different port. Only needed once a camera is plugged into the
# robot and that script is running; otherwise the /control page just
# falls back to the recorded video playlist.
CAMERA_PORT=8000
CAMERA_STREAM_PATH=/stream.mjpg

# E22-900T22U LoRa radio link (lora_link.py / link/lora_server.py on
# Pi #1) -- an alternative control-command transport that extends range
# past WiFi, tried first by _send_command_with_fallback() in app.py
# (WiFi/TCP kept as the automatic fallback), and also the only path
# dgps_relay.py's correction relay below has left once WiFi to Pi #1 is
# down. Left undocumented here until 2026-10-24 (same "silently stays
# off" trap NTRIP_* used to be in, on the robot repo's own .env.example
# -- see lora_link.py's own module-level `os.environ.get(...)` calls and
# app.py's 2026-10-24 comment about load_dotenv() ordering). LORA_ENABLED
# defaults to "0" (off) until the module is actually wired in on Pi #1 --
# flip it to "1" here once it is.
LORA_ENABLED=0
#LORA_SERIAL_PORT=/dev/ttyUSB0
# Must match the module's OWN configured UART baud rate exactly (set
# with the robot repo's tools/lora_configure.py, or the module's own
# config mode) -- this is the Pi<->dongle USB-serial speed, NOT the
# over-the-air rate (see the protocol docs page below on this same
# site). 9600 is both this project's and the module's own factory
# default. 2026-10-24 field finding: the link was saturated by the DGPS
# correction relay alone at the module's factory 2.4 kbps air rate, so
# both Pi's dongles are being raised to 9.6 kbps -- if that's been done,
# this (and the matching LORA_BAUD_RATE on Pi #1) should read 19200,
# not 9600. There's no air-rate-budget constant to update here (that
# lives on Pi #1 only, LORA_AIR_RATE_BYTES_PER_S in its own .env) -- this
# Pi only needs its own UART speed kept in sync with the dongle.
#LORA_BAUD_RATE=9600
# How long _send_command_with_fallback() waits for a real LoRa reply
# before falling through to WiFi for an ordinary console command.
LORA_COMMAND_TIMEOUT=2.0

# NTRIP / DGPS correction stream (2026-10-24: moved here from the robot
# repo's own .env.example -- see dgps_relay.py's module docstring and
# gps/dgps_transfer.py's retirement note in that repo for the full
# story). Pi #2 is the one with the reliable internet connection, so
# it's the one that fetches corrections now and relays one batch/second
# to Pi #1 over WiFi (falling back to LoRa only once that's down) --
# Pi #1 no longer needs its own internet access for this at all.
# Defaults below are the public Centipede test account (crtk.net), same
# as before.
NTRIP_CASTER=crtk.net
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=NEAR
NTRIP_USER=centipede
NTRIP_PASSWORD=centipede
# Set to 0 to turn the whole relay off (e.g. testing without NTRIP
# credentials at hand) -- on by default, since this is now the only
# thing that gets corrections to Pi #1 at all.
DGPS_RELAY_ENABLED=1
